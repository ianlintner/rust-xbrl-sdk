<?xml version="1.0" encoding="UTF-8"?>
<link:linkbase xmlns:link="http://www.xbrl.org/2003/linkbase"
               xmlns:xlink="http://www.w3.org/1999/xlink">
  <link:presentationLink xlink:type="extended" xlink:role="http://example.com/elr/one">
    <link:loc xlink:type="locator" xlink:href="elrs.xsd#A" xlink:label="a"/>
    <link:loc xlink:type="locator" xlink:href="elrs.xsd#B" xlink:label="b"/>
    <link:presentationArc xlink:type="arc" xlink:from="a" xlink:to="b"
        xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="1"/>
  </link:presentationLink>
  <link:presentationLink xlink:type="extended" xlink:role="http://example.com/elr/two">
    <link:loc xlink:type="locator" xlink:href="elrs.xsd#A" xlink:label="a2"/>
    <link:loc xlink:type="locator" xlink:href="elrs.xsd#B" xlink:label="b2"/>
    <link:presentationArc xlink:type="arc" xlink:from="b2" xlink:to="a2"
        xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="1"/>
  </link:presentationLink>
</link:linkbase>
