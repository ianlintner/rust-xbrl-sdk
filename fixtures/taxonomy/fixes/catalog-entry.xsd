<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for this repository. XBRL 2.1 §3.2 DTS discovery reaches the
     catalog-mapped base schema through a remote-named xs:import. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/catalog-entry"
           elementFormDefault="qualified">
  <xs:import namespace="http://example.com/catalog-base"
             schemaLocation="http://remote.example/tax/base.xsd"/>
</xs:schema>
