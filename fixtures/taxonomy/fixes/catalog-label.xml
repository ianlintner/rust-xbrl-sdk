<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for this repository from XBRL 2.1 §5.2.3/§6 and XLink 1.0 §5.1.3:
     the locator uses the remote URI that the catalog maps to the local
     discovered schema. -->
<link:linkbase xmlns:link="http://www.xbrl.org/2003/linkbase"
               xmlns:xlink="http://www.w3.org/1999/xlink">
  <link:labelLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="http://remote.example/tax/base.xsd#Base"
              xlink:label="loc_base"/>
    <link:label xlink:type="resource" xlink:label="lab_base"
                xlink:role="http://www.xbrl.org/2003/role/label"
                xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Catalog-mapped base</link:label>
    <link:labelArc xlink:type="arc" xlink:from="loc_base" xlink:to="lab_base"
                   xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label"/>
  </link:labelLink>
</link:linkbase>
