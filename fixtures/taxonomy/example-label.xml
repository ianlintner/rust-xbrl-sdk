     standard roles http://www.xbrl.org/2003/role/label and .../totalLabel. -->
<link:linkbase xmlns:link="http://www.xbrl.org/2003/linkbase"
               xmlns:xlink="http://www.w3.org/1999/xlink"
               xmlns:ex="http://example.com/taxonomy">
  <link:labelLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="example.xsd#Revenue" xlink:label="rev"/>
    <link:loc xlink:type="locator" xlink:href="example.xsd#Assets" xlink:label="assets"/>
