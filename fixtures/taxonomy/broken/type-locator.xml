<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored negative fixture: one locator to a named type id. -->
<link:linkbase xmlns:link="http://www.xbrl.org/2003/linkbase"
               xmlns:xlink="http://www.w3.org/1999/xlink">
  <link:presentationLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/presentationLink">
    <link:loc xlink:type="locator" xlink:href="type-locator.xsd#CodeType" xlink:label="type"/>
    <link:loc xlink:type="locator" xlink:href="type-locator.xsd#Item" xlink:label="item"/>
    <link:presentationArc xlink:type="arc" xlink:from="type" xlink:to="item"
        xlink:arcrole="http://www.xbrl.org/2003/arcrole/parent-child" order="1"/>
  </link:presentationLink>
</link:linkbase>
